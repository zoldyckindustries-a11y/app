{
  "name": "zaplens-plataforma",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "liberar": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env.local scripts/liberar.mjs",
    "db:init": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env.local scripts/db-init.mjs",
    "start": "next start -p 3002",
    "lint": "next lint",
    "build:next": "next build",
    "build": "opennextjs-cloudflare build --config wrangler.jsonc",
    "deploy:cloudflare": "opennextjs-cloudflare deploy --config wrangler.jsonc",
    "deploy": "npm run build && npm run deploy:cloudflare",
    "preview": "npm run build && opennextjs-cloudflare preview --config wrangler.jsonc",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv --include-runtime=false --include-main-module=false cloudflare-env.d.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "@opennextjs/cloudflare": "^1.20.17",
    "lucide-react": "^0.511.0",
    "next": "^15.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "redis": "^5.5.6"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "wrangler": "^4.162.0"
  }
}
